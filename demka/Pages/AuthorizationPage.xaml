<Page x:Class="demka.Pages.AuthorizationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:demka.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AuthorizationPage">

    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="320">
            <Image Source="/Images/Чудо Обувь.png" Height="80" Stretch="Uniform" Margin="0,0,0,20"/>
            <TextBlock Text="Вход в систему" FontSize="22" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,20"/>
            <TextBlock Text="Логин" Height="15.96" FontFamily="Calibri"/>
            <TextBox x:Name="txtLogin"/>
            <Button Content="Войти" Click="Login_Click" Background="#FF70B2AF"/>
            <Button Content="Войти как гость" Click="Guest_Click" Background="#FFAAAAAA"/>

        </StackPanel>

    </Grid>
</Page>
